DATABASE_URL=postgres://focojur:focojur@localhost:5440/focojur
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="FocoJur <nao-responda@exemplo.com.br>"
STORAGE_DRIVER=local            # local | s3
S3_BUCKET=
AWS_REGION=sa-east-1            # usado pelo driver S3
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=FocoJur
AI_DEFAULT_TIMEOUT_MS=30000
TZ_APP=America/Sao_Paulo

# --- opcionais ---
AI_SUSPEND_AT_LIMIT=false       # true = suspende a IA ao atingir 100% do limite mensal (decisão em aberto, PRD questão 5)
OPENROUTER_MANAGEMENT_KEY=      # só para ler o saldo de créditos (GET /credits exige chave de gerenciamento)
DATAJUD_API_KEY=                # chave pública do CNJ para o DataJud
DJEN_API_URL=                   # padrão: API pública de comunicações do CNJ
DOMICILIO_CLIENT_ID=            # credencial da Foco no Domicílio Judicial Eletrônico
DOMICILIO_CLIENT_SECRET=
PROJURIS_API_URL=               # só se o contrato do Projuris incluir API
PROJURIS_API_TOKEN=
PORTAL_ADAPTERS_ENABLED=        # adaptadores do robô liberados após avaliação dos termos de uso (ex.: eproc-tjrs,pje-tjpe)
SEED_ADMIN_EMAIL=               # obrigatório em produção, junto com SEED_ADMIN_PASSWORD
SEED_ADMIN_PASSWORD=
DJEN_AUTO_REGISTER=true          # tudo que vem do DJEN já é processo em andamento: entra direto em Processos (false = vai para a Triagem)
DJEN_MAX_CATCHUP_DAYS=7         # se a consulta diária ficar parada, recupera no máximo este número de dias
JOBS_INLINE=                    # vazio: automático (dev roda no servidor, produção usa a fila); true/false força
